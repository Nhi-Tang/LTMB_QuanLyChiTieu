FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# Trên server không có file: dán nội dung JSON (hoặc base64) của khóa vào biến này thay cho PATH
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Dev offline: chấp nhận token không kiểm chữ ký. LUÔN để false khi deploy.
ALLOW_UNVERIFIED_TOKEN=false
# Bật /subscription/mock-pay để test khi chưa có cổng thanh toán thật. Để false khi chạy thật.
ENABLE_MOCK_PAY=true

# Giá gói (VND) - phải khớp lib/core/constants/pricing.dart
PRICE_MONTHLY=20000
PRICE_YEARLY=200000
ORDER_TTL_MINUTES=15

# Tài khoản nhận tiền hiển thị trên VietQR
PAYMENT_BANK_ID=MB
PAYMENT_BANK_NAME=MB Bank
PAYMENT_ACCOUNT_NO=0912345678
PAYMENT_ACCOUNT_NAME=MOUSEY APP
PAYMENT_CODE_PREFIX=MSY

# Secret cổng thanh toán (SePay/Casso) gửi kèm webhook. Để trống = tắt webhook.
PAYMENT_WEBHOOK_SECRET=
