FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# Trên server không có file: dán nội dung JSON (hoặc base64) của khóa vào biến này thay cho PATH
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Dev offline: chấp nhận token không kiểm chữ ký. LUÔN để false khi deploy.
ALLOW_UNVERIFIED_TOKEN=false

# Quên mật khẩu: gửi mã OTP qua Brevo (Render free chặn SMTP). Để trống = tắt chức năng.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Mousey
RESET_CODE_TTL_MINUTES=10
RESET_CODE_MAX_ATTEMPTS=5
RESET_CODE_RESEND_SECONDS=60
