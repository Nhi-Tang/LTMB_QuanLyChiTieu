rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Các trường chỉ backend (Admin SDK) được ghi
    function serverFields() {
      // role: trường cũ từ thời còn Admin; isActive: người dùng không tự mở khóa
      return ['role', 'plan', 'planType', 'planSource', 'proExpiredAt', 'trialUsed', 'isActive'];
    }

    // Dữ liệu đồng bộ từ SQLite luôn có updatedAt dạng epoch millis
    function hasValidUpdatedAt() {
      return request.resource.data.updatedAt is number;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(serverFields());

      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverFields());

      allow delete: if false;

      // Đơn hàng và lịch sử gói: chỉ đọc, backend ghi
      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /subscriptions/{subId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Lượt chụp hoá đơn theo tháng (yyyy_MM) của tài khoản FREE: chỉ được tăng đúng 1 mỗi lần,
      // không giảm, không xoá, để gỡ app cài lại cũng không lấy lại được lượt
      match /receipt_quota/{monthId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && monthId.matches('^[0-9]{4}_[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
          && request.resource.data.count == 1;
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
          && request.resource.data.count == resource.data.count + 1;
        allow delete: if false;
      }

      match /ledgers/{ledgerId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && hasValidUpdatedAt();
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      match /transactions/{txId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidUpdatedAt()
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && (!('note' in request.resource.data)
              || request.resource.data.note == null
              || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
      }

      match /savings_goals/{goalId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidUpdatedAt()
          && request.resource.data.target_amount is number
          && request.resource.data.target_amount >= 0;
      }

      match /budgets/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidUpdatedAt()
          && request.resource.data.amountLimit is number
          && request.resource.data.amountLimit >= 0;
      }
    }

    // Chỉ backend (Admin SDK) đọc/ghi: chỉ mục mã thanh toán và log webhook
    match /payment_codes/{code} {
      allow read, write: if false;
    }
    match /payment_events/{eventId} {
      allow read, write: if false;
    }
  }
}
